# SSL 证书邮箱（Let's Encrypt）
ACME_EMAIL=admin@example.com

# 基础域名
BASE_DOMAIN=example.com

# Gitea Runner 注册令牌（从 Gitea 管理后台获取）
# 路径: 站点管理 → Actions → Runners → 创建 Runner 令牌
GITEA_RUNNER_TOKEN=please_set_your_runner_token

# pgAdmin 默认登录邮箱与端口（用于 IP+端口 访问）
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_PORT=5050

# 自定义直连端口（IP+端口访问）
# PostgreSQL 映射到宿主机端口
POSTGRES_PORT=5432
# Gitea Web 映射到宿主机端口
GITEA_HTTP_PORT=3000
# Gitea SSH 映射到宿主机端口
GITEA_SSH_PORT=2222

# Gitea 定时备份到阿里云 OSS（配置 secrets/alicloud_access_key.txt 和 secrets/alicloud_secret_key.txt 后生效）
# OSS Endpoint，按 bucket 所在地域填写
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# 专用于备份的 OSS bucket 名称（建议单独新建，不要复用其它用途的 bucket）
OSS_BUCKET=your-gitea-backup-bucket
# 备份对象在 bucket 内的路径前缀
OSS_PREFIX=gitea-backups
# 备份执行计划（crontab 格式），默认每天 03:00
BACKUP_CRON_SCHEDULE=0 3 * * *
# 本地（backup_data 卷）保留的备份份数，超出的自动删除；OSS 侧的过期依赖 bucket 生命周期规则（见 SECRETS.md）
BACKUP_LOCAL_KEEP=7
